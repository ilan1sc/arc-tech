{"path": "/projects", "params": {"search": "map visualization", "per_page": 8, "order_by": "star_count", "sort": "desc", "simple": "true", "visibility": "public"}, "data": [{"id": 75779027, "description": "Prototyping a modernization for the San Diego Astronomy Association-private pad site map.  A desktop browser-based, data-driven interactive visualization UX.", "name": "SDAA-Pad-Explorer", "name_with_namespace": "idea building / SDAA-Pad-Explorer", "path": "sdaa-pad-explorer", "path_with_namespace": "idea-building/sdaa-pad-explorer", "created_at": "2025-11-02T23:10:33.474Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:idea-building/sdaa-pad-explorer.git", "http_url_to_repo": "https://gitlab.com/idea-building/sdaa-pad-explorer.git", "web_url": "https://gitlab.com/idea-building/sdaa-pad-explorer", "readme_url": "https://gitlab.com/idea-building/sdaa-pad-explorer/-/blob/main/readme.md", "forks_count": 0, "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/75779027/gitlab_logo-192x192.jpg?v=1764959572", "star_count": 1, "last_activity_at": "2025-12-05T18:32:52.466Z", "visibility": "public", "namespace": {"id": 89269488, "name": "idea building", "path": "idea-building", "kind": "group", "full_path": "idea-building", "parent_id": null, "avatar_url": null, "web_url": "https://gitlab.com/groups/idea-building"}}, {"id": 55295406, "description": "ShipWeather: Maritime Weather Prediction App\r\n\r\nOverview:\r\nShipWeather, a Flask-based web app, offers real-time maritime weather predictions. Integrated with OpenWeatherMap API, it provides accurate data based on user inputs. The user-friendly interface caters to shippers, ensuring easy access to precise weather estimates crucial for maritime planning.\r\n\r\nFeatures & Functionalities\r\n\r\n    Intuitive Interface: Latitude, longitude, and city name inputs simplify access to accurate maritime weather information.\r\n\r\n    OpenWeatherMap API Integration: Secure integration with stored API key prioritizes data security.\r\n\r\n    Data Processing and Visualization: Converts temperature units to Fahrenheit, uses weather icons for quick visual comprehension.\r\n\r\n    Tailored for Shippers: Meets unique needs by providing reliable and timely weather estimates.\r\n\r\n    Error Handling: Robust handling for invalid input or failed data retrieval ensures a smooth user experience.\r\n\r\nUsage:\r\n\r\n    Clone Repository: Start by cloning ShipWeather for local use.\r\n    Set Environment Variables: Configure variables, including the OpenWeatherMap API key, for secure integration.\r\n    Run Flask Application: Launch ShipWeather to access accurate maritime weather predictions.\r\n    Input for Predictions: Enter latitude, longitude, or city name for informed decision-making.\r\n\r\nContributions:\r\nShipWeather invites community contributions. Fork the repository, submit pull requests, and enhance app functionality.\r\n\r\nDependencies:\r\n\r\n    Flask\r\n    OpenWeatherMap API\r\n\r\n", "name": "python-flask-weather-prediction-app", "name_with_namespace": "Swapna Adhav / python-flask-weather-prediction-app", "path": "python-flask-weather-prediction-app", "path_with_namespace": "swapnagitlab/python-flask-weather-prediction-app", "created_at": "2024-02-26T08:03:14.223Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:swapnagitlab/python-flask-weather-prediction-app.git", "http_url_to_repo": "https://gitlab.com/swapnagitlab/python-flask-weather-prediction-app.git", "web_url": "https://gitlab.com/swapnagitlab/python-flask-weather-prediction-app", "readme_url": "https://gitlab.com/swapnagitlab/python-flask-weather-prediction-app/-/blob/main/README.md", "forks_count": 1, "avatar_url": null, "star_count": 1, "last_activity_at": "2024-03-27T00:11:40.739Z", "visibility": "public", "namespace": {"id": 82369713, "name": "Swapna Adhav", "path": "swapnagitlab", "kind": "user", "full_path": "swapnagitlab", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/6bb1f035ad46ed4c2b167ddf462ef523068cf11ba156bfe34f66fc4d595b5823?s=80&d=identicon", "web_url": "https://gitlab.com/swapnagitlab"}}, {"id": 18096725, "description": "Network visualization of OMOP mapping", "name": "networkomop", "name_with_namespace": "Raphaele / networkomop", "path": "networkomop", "path_with_namespace": "raphaele_adjerad/networkomop", "created_at": "2020-04-13T07:34:49.823Z", "default_branch": "master", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:raphaele_adjerad/networkomop.git", "http_url_to_repo": "https://gitlab.com/raphaele_adjerad/networkomop.git", "web_url": "https://gitlab.com/raphaele_adjerad/networkomop", "readme_url": "https://gitlab.com/raphaele_adjerad/networkomop/-/blob/master/README.md", "forks_count": 0, "avatar_url": null, "star_count": 1, "last_activity_at": "2020-04-13T07:34:49.823Z", "visibility": "public", "namespace": {"id": 4265868, "name": "Raphaele", "path": "raphaele_adjerad", "kind": "user", "full_path": "raphaele_adjerad", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/9e06a585c5f3f4dc2ceeac335ae08c6a16b1f43d9a67fb4dce943020645364c1?s=80&d=identicon", "web_url": "https://gitlab.com/raphaele_adjerad"}}, {"id": 15633274, "description": "Grafana Trackmap Atomic Service provides an easy way to visualize data from a time series datasource with NGSIv2 format\r\n#AtomicService #Visualization #TimeSeries #MapBased", "name": "GrafanaTrackmapAtomicService", "name_with_namespace": "synchronicity-iot / GrafanaTrackmapAtomicService", "path": "grafanatrackmapatomicservice", "path_with_namespace": "synchronicity-iot/grafanatrackmapatomicservice", "created_at": "2019-12-02T10:12:38.825Z", "default_branch": "master", "tag_list": ["Atomic Service", "atomicservice", "grafana"], "topics": ["Atomic Service", "atomicservice", "grafana"], "ssh_url_to_repo": "git@gitlab.com:synchronicity-iot/grafanatrackmapatomicservice.git"