ased Access Control (RBAC) dan User Access Request (UAR) workflow. Dirancang khusus untuk kebutuhan Telkominfra, package ini mendukung:\r\n\r\n- Manajemen role & permission per aplikasi (RBAC)\r\n- Workflow User Access Request dengan approval multi-level\r\n- Integrasi struktur organisasi (Direktorat, Unit, Employee)\r\n- Period-based access (akses berbasis tanggal)\r\n- Audit trail & soft delete untuk integritas data\r\n- Multi-application support (isolasi RBAC per aplikasi)\r\n- Dokumentasi lengkap & 300+ passing tests\r\n\r\nTech stack: Laravel 7.2+, PHP 5.6+, MySQL/MariaDB, PHPUnit, PHPStan.", "name": "User Access Management", "name_with_namespace": "Telkominfra / User Access Management", "path": "user-access-management", "path_with_namespace": "telkominfraapps/user-access-management", "created_at": "2025-10-23T00:05:28.342Z", "tag_list": ["access-control", "authentication", "authorization", "database", "laravel", "laravel-package", "permission-management", "php", "rbac", "role-based-access-control", "user-access-management", "user-management"], "topics": ["access-control", "authentication", "authorization", "database", "laravel", "laravel-package", "permission-management", "php", "rbac", "role-based-access-control", "user-access-management", "user-management"], "ssh_url_to_repo": "git@gitlab.com:telkominfraapps/user-access-management.git", "http_url_to_repo": "https://gitlab.com/telkominfraapps/user-access-management.git", "web_url": "https://gitlab.com/telkominfraapps/user-access-management", "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/75529564/uam-logo-resized.png?v=1793543287", "star_count": 1, "last_activity_at": "2026-11-01T14:28:07.404Z", "visibility": "public", "namespace": {"id": 4878074, "name": "Telkominfra", "path": "telkominfraapps", "kind": "user", "full_path": "telkominfraapps", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/3746980/avatar.png?v=1794194898", "web_url": "https://gitlab.com/telkominfraapps"}}, 