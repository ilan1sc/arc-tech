"http_url_to_repo": "https://gitlab.com/gabrielepmattia/simulator-2021-nca.git", "web_url": "https://gitlab.com/gabrielepmattia/simulator-2021-nca", "readme_url": "https://gitlab.com/gabrielepmattia/simulator-2021-nca/-/blob/master/README.md", "forks_count": 0, "avatar_url": null, "star_count": 2, "last_activity_at": "2024-04-09T08:30:19.826Z", "visibility": "public", "namespace": {"id": 1010598, "name": "Gabriele Proietti Mattia", "path": "gabrielepmattia", "kind": "user", "full_path": "gabrielepmattia", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/844242/avatar.png?v=1794213040", "web_url": "https://gitlab.com/gabrielepmattia"}}, {"id": 8925455, "description": "This project builds a software architecture for a hierarchical mobile edge computing system that jointly supports container migration and base station handover for mobile users. ", "name": "edgecomputing", "name_with_namespace": "Ngo Van Mao / edgecomputing", "path": "edgecomputing", "path_with_namespace": "ngovanmao/edgecomputing", "created_at": "2018-10-18T06:58:31.915Z", "default_branch": "master", "tag_list": ["Docker container migration", "handover", "mobile edge computing (MEC)", "mobile user"], "topics": ["Docker container migration", "handover", "mobile edge computing (MEC)", "mobile user"], "ssh_url_to_repo": "git@gitlab.com:ngovanmao/edgecomputing.git", "http_url_to_repo": "https://gitlab.com/ngovanmao/edgecomputing.git", "web_url": "https://gitlab.com/ngovanmao/edgecomputing", "readme_url": "https://gitlab.com/ngovanmao/edgecomputing/-/blob/master/README.md", "forks_count": 0, "avatar_url": null, "star_count": 2, "last_activity_at": "2020-11-25T13:52:42.472Z", "visibility": "public", "namespace": {"id": 1720621, "name": "Ngo Van Mao", "path": "ngovanmao", "kind": "user", "full_path": "ngovanmao", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/1423057/avatar.png?v=1794182718", "web_url": "https://gitlab.com/ngovanmao"}}, {"id": 64647921, "description": "\ud83d\ude80 Scully C++ Framework\r\n\r\n\ud83c\udfaf Enterprise-Grade High-Performance Computing Platform\r\nA cutting-edge C++20 framework for building modern distributed systems and high-performance applications. Production-proven architecture designed for 10,000+ concurrent connections and enterprise-scale workloads.\r\n\r\n\ud83c\udf1f What Makes This Special\r\n\r\n\ud83d\udd25 Ultra-High Performance\r\nFiber-based architecture with cooperative multitasking\r\nSIMD-optimized memory management and vectorized operations\r\nLock-free data structures with work-stealing thread pools\r\nZero-copy I/O and memory-mapped file operations\r\nHardware-accelerated cryptography (AES-NI, SIMD hashing)\r\n\r\n\ud83c\udfd7\ufe0f Enterprise Framework Architecture\r\n60+ specialized addons covering everything from Redis clustering to ML allocators\r\nCross-platform support (Windows, Linux, macOS, iOS, Android)\r\nAdvanced diagnostics with profiling, metrics collection, and crash reporting\r\nModern C++20 with extensive template metaprogramming\r\n\r\n\ud83d\udd27 Developer Experience\r\n60+ ready-to-use addons\r\nComprehensive unit test suite (GoogleTest)\r\nHot-reloadable configuration\r\nRich debugging and profiling tools\r\n\r\n\ud83c\udf0d Cross-Platform Excellence\r\nVisual Studio 2015-2022 support\r\nAndroid NDK (r22/r27) with all architectures\r\niOS/macOS with Xcode integration\r\nLinux distributions", "name": "Scully", "name_with_namespace": "dargun / Scully", "path": "scully", "path_with_namespace": "Dargun/scully", "created_at": "2024-11-19T11:11:03.309Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:Dargun/scully.git", "http_url_to_repo": "https://gitlab.com/Dargun/scully.git", "web_url": "https://gitlab.com/Dargun/scully", "readme_url": "https://gitlab.com/Dargun/scully/-/blob/main/README.md", "forks_count": 0, "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/64647921/scully-avatar2-small.gif?v=1776815843", "sta