id": 1010598, "name": "Gabriele Proietti Mattia", "path": "gabrielepmattia", "kind": "user", "full_path": "gabrielepmattia", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/844242/avatar.png?v=1794213040", "web_url": "https://gitlab.com/gabrielepmattia"}}, {"id": 35861416, "description": "\u2139\ufe0f **CLara** is a framework by Bj\u00f6rn K\u00f6nig that enables you to access the computing power of many graphics processors in an IP-based network using a kind of Client/Proxy/Server model. Its programming interface conforms to the OpenCL 1.0 standard.\r\n\r\n\ud83d\udca1\ufe0f The repository has been migrated [from sourceforge subversion](https://sourceforge.net/projects/clara/), build fixed and build system migrated to CMake.\r\n\r\n\ud83d\udea7\ufe0f **Status: Pre-Alpha.** \u26a0\ufe0f **There is no active developer.** \u2753\ufe0f **Do you have good knowledge of OpenCL? Let's revive it!** \ud83d\ude80\ufe0f", "name": "CLara", "name_with_namespace": "Thomas Debesse / CLara", "path": "clara", "path_with_namespace": "illwieckz/clara", "created_at": "2022-05-03T22:21:25.649Z", "default_branch": "master", "tag_list": ["compute", "network", "networking", "opencl"], "topics": ["compute", "network", "networking", "opencl"], "ssh_url_to_repo": "git@gitlab.com:illwieckz/clara.git", "http_url_to_repo": "https://gitlab.com/illwieckz/clara.git", "web_url": "https://gitlab.com/illwieckz/clara", "readme_url": "https://gitlab.com/illwieckz/clara/-/blob/master/README.md", "forks_count": 0, "avatar_url": null, "star_count": 1, "last_activity_at": "2024-01-13T03:54:10.395Z", "visibility": "public", "namespace": {"id": 230142, "name": "Thomas Debesse", "path": "illwieckz", "kind": "user", "full_path": "illwieckz", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/195241/avatar.png?v=1794214524", "web_url": "https://gitlab.com/illwieckz"}}]}