ansformer-256dim", "path_with_namespace": "Sid7on1/Transformer-256dim", "created_at": "2026-06-12T18:10:22.770Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:Sid7on1/Transformer-256dim.git", "http_url_to_repo": "https://gitlab.com/Sid7on1/Transformer-256dim.git", "web_url": "https://gitlab.com/Sid7on1/Transformer-256dim", "readme_url": "https://gitlab.com/Sid7on1/Transformer-256dim/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-06-12T18:10:22.643Z", "visibility": "public", "namespace": {"id": 134588973, "name": "Siddharth Vishwanath", "path": "Sid7on1", "kind": "user", "full_path": "Sid7on1", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/93724f24a148944d43c46e3c1783122c657ae68aa267eddea2c8d2c7065eaa95?s=80&d=identicon", "web_url": "https://gitlab.com/Sid7on1"}}, {"id": 82983942, "description": "BrandFuzzySearch is a multi-source search tool that tolerates spelling variants to look up registered trademarks, patents, domain names and companies (legal names, acronyms) across official registries, with geographic priority on the EU and Switzerland.\r\nIt is built as a Rust cargo workspace: a shared core (bfs-core) provides an async Source trait, text normalization (including cross-script transliteration) and a hybrid fuzzy re-ranking engine, while dedicated crates wrap real data sources \u2014 EUIPO, EPO, INPI, INSEE, Swissreg, Zefix, ARES, PRH, CVR/DataFordeler and RDAP. An optional multi-agent LLM pipeline (bfs-llm, llama.cpp) enriches results with analysis grounded in cached open data. It ships as a CLI (bfs), an Axum HTTP API (bfs-api) and an Astro front end.\r\nExternal access is read-only by design (no writes to upstream APIs, enforced by a build-time guardrail), with encryption at rest, GDPR purge, an SBOM and supply-chain checks in CI.\r\n\u26a0\ufe0f  The tool produces a preliminary study only. It does not replace the explanations, research or advice of a professional or of a lawyer specialising in trademark or company registration.\r\nLicensed under MPL-2.0.", "name": "BrandFuzzysearch-LLM", "name_with_namespace": "YP-SEC / BrandFuzzysearch-LLM", "path": "brandfuzzysearch-llm", "path_with_namespace": "ypsec/brandfuzzysearch-llm", "created_at": "2026-06-07T17:46:08.103Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:ypsec/brandfuzzysearch-llm.git", "http_url_to_repo": "https://gitlab.com/ypsec/brandfuzzysearch-llm.git", "web_url": "https://gitlab.com/ypsec/brandfuzzysearch-llm", "readme_url": "https://gitlab.com/ypsec/brandfuzzysearch-llm/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-11-01T20:02:06.032Z", "visibility": "public", "namespace": {"id": 117857936, "name": "YP-SEC", "path": "ypsec", "kind": "user", "full_path": "ypsec", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/31168312/avatar.png?v=1793861223", "web_url": "https://gitlab.com/ypsec"}}]}