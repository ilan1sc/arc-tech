ask Management: Jira\r\n\r\n\ud83d\ude80 Features\r\n\r\n    Teacher profile management\r\n    Course listing and enrollment\r\n    Secure authentication & authorization\r\n    Cloud-based deployment with Azure\r\n    Automated CI/CD for seamless updates", "name": "Dirasati", "name_with_namespace": "1CS_Team / Dirasati", "path": "dirasati", "path_with_namespace": "1cs_team/dirasati", "created_at": "2025-02-21T22:33:37.488Z", "default_branch": "main", "tag_list": ["GitLab CI/CD", "azure", "docker", "inertiajs", "laravel", "react"], "topics": ["GitLab CI/CD", "azure", "docker", "inertiajs", "laravel", "react"], "ssh_url_to_repo": "git@gitlab.com:1cs_team/dirasati.git", "http_url_to_repo": "https://gitlab.com/1cs_team/dirasati.git", "web_url": "https://gitlab.com/1cs_team/dirasati", "readme_url": "https://gitlab.com/1cs_team/dirasati/-/blob/main/README.md", "forks_count": 0, "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/67365691/DirasatiLogoWHite.png?v=1748793293", "star_count": 2, "last_activity_at": "2025-06-01T15:54:53.423Z", "visibility": "public", "namespace": {"id": 102520866, "name": "1CS_Team", "path": "1cs_team", "kind": "group", "full_path": "1cs_team", "parent_id": null, "avatar_url": null, "web_url": "https://gitlab.com/groups/1cs_team"}}, {"id": 15622066, "description": "A Starlette middleware for authentication and authorization through oauth2.", "name": "Starlette Oauth2", "name_with_namespace": "Jorge C. Leit\u00e3o / Starlette Oauth2", "path": "starlette-oauth2", "path_with_namespace": "jorgecarleitao/starlette-oauth2", "created_at": "2019-12-01T16:01:37.051Z", "default_branch": "master", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:jorgecarleitao/starlette-oauth2.git", "http_url_to_repo": "https://gitlab.com/jorgecarleitao/starlette-oauth2.git", "web_url": "https://gitlab.com/jorgecarleitao/starlette-oauth2", "readme_url": "https://gitlab.com/jorgecarleitao/starlette-oauth2/-/blob/master/README.md", "forks_count