2025-01-15T19:34:44.647Z", "visibility": "public", "namespace": {"id": 97746627, "name": "massa", "path": "massa5920047", "kind": "group", "full_path": "massa5920047", "parent_id": null, "avatar_url": null, "web_url": "https://gitlab.com/groups/massa5920047"}}, {"id": 62272228, "description": null, "name": "UI_Egistic_Openlayers", "name_with_namespace": "\u041e\u0440\u0430\u043b \u0421\u043c\u0430\u0433\u0443\u043b\u043e\u0432\u0430 / UI_Egistic_Openlayers", "path": "ui_egistic_openlayers", "path_with_namespace": "oral.smagulova/ui_egistic_openlayers", "created_at": "2024-10-04T13:56:36.824Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:oral.smagulova/ui_egistic_openlayers.git", "http_url_to_repo": "https://gitlab.com/oral.smagulova/ui_egistic_openlayers.git", "web_url": "https://gitlab.com/oral.smagulova/ui_egistic_openlayers", "readme_url": "https://gitlab.com/oral.smagulova/ui_egistic_openlayers/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2024-12-30T00:31:14.142Z", "visibility": "public", "namespace": {"id": 60788184, "name": "\u041e\u0440\u0430\u043b \u0421\u043c\u0430\u0433\u0443\u043b\u043e\u0432\u0430", "path": "oral.smagulova", "kind": "user", "full_path": "oral.smagulova", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/f07d68228352ea1afa7dfe27ec0cff83d8ea670c80dd8cb57a745747d527e9e0?s=80&d=identicon", "web_url": "https://gitlab.com/oral.smagulova"}}, {"id": 58149943, "description": "# \ud83c\udf6b Chocolate Factory Web Application\r\n\r\n## \ud83d\udccc Project Overview\r\n\r\nThe Chocolate Factory Web Application is a full-stack project built using **Java (JAX-RS) for the backend** and **Vue.js for the frontend**. It allows users to search for chocolate factories, filter results based on various criteria, and view detailed information, including location maps. The application utilizes **CSV files for data storage** instead of a traditional database.\r\n\r\n## \ud83d\udee0\ufe0f Features\r\n\r\n- \ud83d\udd0d **Factory Search**: Search chocolate factories by name and location.\r\n- \ud83c\udfed **Filtering Options**: Filter by chocolate type (**dark, white**) and category (**cooking, ordinary**).\r\n- \ud83d\udd52 **Factory Status**: View only open factories based on business hours.\r\n- \ud83d\uddfa\ufe0f **Map Integration**: Factory locations are displayed on an interactive map using **OpenLayers**.\r\n- \ud83d\udd10 **Authentication & Authorization**: Implemented using **JWT (JSON Web Token)**.\r\n- \ud83d\uddc4\ufe0f **Data Storage**: Uses **CSV files** instead of a database.\r\n- \ud83d\udcca **Logging**:\r\n  - **Logging mechanisms** for debugging and error tracking.\r\n\r\n### Backend:\r\n\r\n- **Java (JAX-RS)** \u2013 REST API implementation\r\n- **CSV Files** \u2013 Data storage\r\n- **JWT** \u2013 Authentication\r\n\r\n### Frontend:\r\n\r\n- **Vue.js** \u2013 UI framework\r\n- **Vue Router & Vuex** \u2013 State management and navigation\r\n- **OpenLayers** \u2013 Interactive maps\r\n\r\n##\r\n\r\n", "name": "chocolate-factory", "name_with_namespace": "grupa6 / chocolate-factory", "path": "web-projekat", "path_with_namespace": "grupa62190421/web-projekat", "created_at": "2024-05-23T18:05:01.368Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:grupa62190421/web-projekat.git", "http_url_to_repo": "https://gitlab.com/grupa62190421/web-projekat.git", "web_url": "https://gitlab.com/grupa62190421/web-projekat", "readme_url": "https://gitlab.com/grupa62190421/web-projekat/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2025-03-22T01:26:40.419Z", "visibility": "public", "namespace": {"id": 87722108, "name": "grupa6", "path": "grupa62190421", "kind": "group", "full_path": "grupa62190421", "parent_id": null, "avatar_url": null, "web_url": "https://gitlab.com/groups/grupa62190421"}}]}