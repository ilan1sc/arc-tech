ation.", "name": "Brainor", "name_with_namespace": "Benjamin Morel / Brainor", "path": "brainor", "path_with_namespace": "bmorel/brainor", "created_at": "2026-04-24T09:25:45.776Z", "default_branch": "main", "tag_list": ["computer vision", "python", "semantic segmentation", "tensorflow"], "topics": ["computer vision", "python", "semantic segmentation", "tensorflow"], "ssh_url_to_repo": "git@gitlab.com:bmorel/brainor.git", "http_url_to_repo": "https://gitlab.com/bmorel/brainor.git", "web_url": "https://gitlab.com/bmorel/brainor", "readme_url": "https://gitlab.com/bmorel/brainor/-/blob/main/README.md", "forks_count": 0, "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/81609021/irm.png?v=1783330057", "star_count": 0, "last_activity_at": "2026-07-01T20:05:56.328Z", "visibility": "public", "namespace": {"id": 101637795, "name": "Benjamin Morel", "path": "bmorel", "kind": "user", "full_path": "bmorel", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/0bab1e70cfae3323000ec59b05ba7abc000615da4347e2721df70019d3e57861?s=80&d=identicon", "web_url": "https://gitlab.com/bmorel"}}, {"id": 81371091, "description": "Semantic Vectorizing and Masking Creator: A desktop application for AI-powered image segmentation, masking, and vectorization.", "name": "skiagrafia", "name_with_namespace": "Charis Tsevis / skiagrafia", "path": "skiagrafia", "path_with_namespace": "tsevis/skiagrafia", "created_at": "2026-04-16T12:55:34.426Z", "default_branch": "main", "tag_list": ["computer-vision", "desktop-app", "image-segmentation", "masking", "python", "vectorization", "visual-design"], "topics": ["computer-vision", "desktop-app", "image-segmentation", "masking", "python", "vectorization", "visual-design"], "ssh_url_to_repo": "git@gitlab.com:tsevis/skiagrafia.git", "http_url_to_repo": "https://gitlab.com/tsevis/skiagrafia.git", "web_url": "https://gitlab.com/tsevis/skiagrafia", "readme_url": "https://gitlab.com/tsevis/skiagrafia/-/blob/main/README.md", "forks_cou