ull, "star_count": 0, "last_activity_at": "2026-07-08T06:54:34.669Z", "visibility": "public", "namespace": {"id": 134651476, "name": "Aneesh Banerjee", "path": "Jiraiyaaaa", "kind": "user", "full_path": "Jiraiyaaaa", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/3cfd94bd716532c678417b4b4cc2737ade89782d67256f640d7c0bef4f159141?s=80&d=identicon", "web_url": "https://gitlab.com/Jiraiyaaaa"}}, {"id": 81111445, "description": "Developed a web-based DBMS inventory management system using PHP, HTML, CSS, and MySQL with features like user authentication, stock tracking, and report generation. Designed a responsive interface with automated low-stock alerts and notifications to improve inventory control, operational efficiency, and user experience.", "name": "Stationery-Management-System", "name_with_namespace": "Sameeksha / Stationery-Management-System", "path": "Stationery-Management-System", "path_with_namespace": "sameekshakadaba/Stationery-Management-System", "created_at": "2026-04-08T05:37:56.622Z", "default_branch": "main", "tag_list": ["CSS3", "PHP CRUD", "PHP+MYSQL", "Vanilla JavaScript", "css", "html", "html5", "javascript", "xampp"], "topics": ["CSS3", "PHP CRUD", "PHP+MYSQL", "Vanilla JavaScript", "css", "html", "html5", "javascript", "xampp"], "ssh_url_to_repo": "git@gitlab.com:sameekshakadaba/Stationery-Management-System.git", "http_url_to_repo": "https://gitlab.com/sameekshakadaba/Stationery-Management-System.git", "web_url": "https://gitlab.com/sameekshakadaba/Stationery-Management-System", "readme_url": "https://gitlab.com/sameekshakadaba/Stationery-Management-System/-/blob/main/README.md", "forks_count": 0, "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/81111445/lucid-origin_create_a_colorful_and_vibrant_animated_image_of_an_online_stationery_management_-0.jpg?v=1775653206", "star_count": 0, "last_activity_at": "2026-04-08T13:00:06.075Z", "visibility": "public", "namespace": {"id": 129244256, "name": "Sameeksha", "path": "sameekshakadaba", "kind": "user", "full_path": "sameekshakadaba", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/36619219/avatar.png?v=1785914088", "web_url": "https://gitlab.com/sameekshakadaba"}}, {"id": 81011243, "description": "App Name: CryptoTicker\n\nDescription:\n\nCryptoTicker is your go-to app for staying up-to-date with real-time cryptocurrency market data. With seamless WebSocket integration, it delivers live ticker updates for a wide range of cryptocurrency pairs, focusing on the Binance exchange.\n\nKey Features:\n\nReal-Time Ticker Updates: Enjoy instant access to real-time data for your favorite cryptocurrency pairs, including BTC/USDT, ETH/BTC, and more. Track price changes, trade volumes, and other essential market metrics.\nUser-Friendly Interface: CryptoTicker offers an intuitive and user-friendly interface, making it easy for both beginners and experienced traders to keep a close eye on market movements.\nCustomizable Watchlist: Create a personalized watchlist of cryptocurrencies to monitor. Set alerts for price thresholds and receive notifications when specific conditions are met.\nWebSocket Integration: Powered by WebSocket technology, CryptoTicker ensures you're always in the loop. WebSocket connections are established in real-time, delivering data as it happens.\nEfficient Resource Management: The app is designed to be resource-efficient, ensuring minimal battery and data usage while running in the background.\nDetailed Information: Dive deeper into the world of cryptocurrencies with detailed information on each trading pair, including open, high, low, close prices, and more.\nSecure and Reliable: Built with security in mind, CryptoTicker ensures a safe and reliable experience when tracking market data.\nWhy Choose CryptoTicker:\n\nStay ahead in the fast-paced world of cryptocurrency trading with CryptoTicker. Whether you're a casual investor or a professional trader, our app offers the tools and real-time data you need to make informed decisions and maximize your trading potential.\n\nGet CryptoTicker today and take control of your cryptocurrency investments. Stay informed, stay profitable!", "name": "StocksWatcher", "name_with_namespace": "BugsResearchFundementals-group / StocksWatcher", "path": "StocksWatcher", "path_with_namespace": "bugsresearchfundementals-group/StocksWatcher", "created_at": "2026-04-04T06:02:49.835Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:bugsresearchfundementals-group/StocksWatcher.git", "http_url_to_repo": "https://gitlab.com/bugsresearchfundementals-group/StocksWatcher.git", "web_url": "https://gitlab.com/bugsresearchfundementals-group/StocksWatcher", "readme_url": null, "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-04-04T06:02:49.773Z", "visibility": "public", "namespace": {"id": 128024410, "name": "BugsResearchFundementals-group", "path": "bugsresearchfundementals-group", "kind": "group", "full_path": "bugsresearchfundementals-group", "parent_id": null, "avatar_url": null, "web_url": "https://gitlab.com/groups/bugsresearchfundementals-group"}}, {"id": 80964568, "description": "PathAI \u2013 Compliance Made Simple is an open-source AI-powered cloud platform for fleet management. It automatically tracks GPS data to generate compliance reports, optimize routes, predict maintenance needs, and improve driver safety. With real-time alerts, predictive analytics, and automated reporting, PathAI simplifies fleet operations, ensures regulatory compliance, and provides actionable insights for managers and drivers.  https://roxanneardary.com/pathai/", "name": "PathAI", "name_with_namespace": "Roxanne Ardary / PathAI", "path": "pathai", "path_with_namespace": "Roxanne_Ardary/pathai", "created_at": "2026-04-02T12:59:46.214Z", "default_branch": "main", "tag_list": ["AI", "Cloud Computing", "Fleet Management", "Fleet Management System", "GPS", "SBL", "SDD", "agplv3", "automotive", "legal", "open-source", "open-source-licenses", "predictive-modeling", "roxanneardary", "spec-driven-development", "specification", "specification-branding-license"], "topics": ["AI", "Cloud Computing", "Fleet Management", "Fleet Management System", "GPS", "SBL", "SDD", "agplv3", "automotive", "legal", "open-source", "open-source-licenses", "predictive-modeling", "roxanneardary", "spec-driven-development", "specification", "specification-branding-license"], "ssh_url_to_repo": "git@gitlab.com:Roxanne_Ardary/pathai.git", "http_url_to_repo": "https://gitlab.com/Roxanne_Ardary/pathai.git", "web_url": "https://gitlab.com/Roxanne_Ardary/pathai", "readme_url": "https://gitlab.com/Roxanne_Ardary/pathai/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-08-09T16:24:29.376Z", "visibility": "public", "namespace": {"id": 127620387, "name": "Roxanne Ardary", "path": "Roxanne_Ardary", "kind": "user", "full_path": "Roxanne_Ardary", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/cfb773bd0e89e6ce1e5b9a1e71804159d1ac3618d6d8c71e57fb042adc4aea9f?s=80&d=identicon", "web_url": "https://gitlab.com/Roxanne_Ardary"}}]}