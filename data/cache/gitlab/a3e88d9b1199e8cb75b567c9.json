reated_at": "2026-10-27T08:27:03.795Z", "default_branch": "main", "tag_list": ["AGPL3", "AI", "SBL", "SDD", "ai-analysis", "analytics", "open-source", "open-source-licenses", "roxanneardary", "spec-driven-development", "specification", "specification-branding-license", "web-analytics", "website-traffic"], "topics": ["AGPL3", "AI", "SBL", "SDD", "ai-analysis", "analytics", "open-source", "open-source-licenses", "roxanneardary", "spec-driven-development", "specification", "specification-branding-license", "web-analytics", "website-traffic"], "ssh_url_to_repo": "git@gitlab.com:Roxanne_Ardary/echoanalytics.git", "http_url_to_repo": "https://gitlab.com/Roxanne_Ardary/echoanalytics.git", "web_url": "https://gitlab.com/Roxanne_Ardary/echoanalytics", "readme_url": "https://gitlab.com/Roxanne_Ardary/echoanalytics/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-10-27T08:55:56.877Z", "visibility": "public", "namespace": {"id": 127620387, "name": "Roxanne Ardary", "path": "Roxanne_Ardary", "kind": "user", "full_path": "Roxanne_Ardary", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/cfb773bd0e89e6ce1e5b9a1e71804159d1ac3618d6d8c71e57fb042adc4aea9f?s=80&d=identicon", "web_url": "https://gitlab.com/Roxanne_Ardary"}}, {"id": 87793924, "description": "\u2022 Developed and deployed an interactive media analytics dashboard analyzing 150 English-language political news articles across six major South Korean publications.\r\n\u2022 Applied TF-IDF vectorization and K-Means clustering to identify recurring themes and examine differences in political news coverage across publications.\r\n\u2022 Designed a Snowflake cloud analytics layer using relational tables and SQL reporting views to support publication-level comparisons, topic distributions, and NLP cluster analysis.\r\n\u2022 Integrated Snowflake with Streamlit using RSA key-pair authentication and role-based, read-only access, enabling secure retrieval of cloud-hosted analytics.\r\n\u2022 Deployed the application through GitLab and Render, delivering an accessible, interactive portfolio project with publication filters, visualizations, and downloadable analytical results.", "name": "South Korean Political News Analytics", "name_with_namespace": "Katarina / South Korean Political News Analytics", "path": "south-korean-political-news-analytics", "path_with_namespace": "katarina.hds/south-korean-political-news-analytics", "created_at": "2026-10-18T22:49:56.371Z", "default_branch": "main", "tag_list": ["Render", "pandas", "pandas-python", "plotly", "python", "scikit-learn", "sql", "streamlit"], "topics": ["Render", "pandas", "pandas-python", "plotly", "python", "scikit-learn", "sql", "streamlit"], "ssh_url_to_repo": "git@gitlab.com:katarina.hds/south-korean-political-news-analytics.git", "http_url_to_repo": "https://gitlab.com/katarina.hds/south-korean-political-news-analytics.git", "web_url": "https://gitlab.com/katarina.hds/south-korean-political-news-analytics", "readme_url": "https://gitlab.com/katarina.hds/south-korean-political-news-analytics/-/blob/main/README.md", "forks_count": 0, "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/87793924/south_korean_political_news_avatar.jpg?v=1793143510", "star_count": 0, "last_activity_at": "2026-10-27T23:25:10.033Z", "visibility": "public", "namespace": {"id": 92164981, "name": "Katarina", "path": "katarina.hds", "kind": "user", "full_path": "katarina.hds", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/22525693/avatar.png?v=1793454196", "web_url": "https://gitlab.com/katarina.hds"}}, {"id": 86766946, "description": null, "name": "GCP_Reporting_Dashboard", "name_with_namespace": "Gregory Urena / GCP_Reporting_Dashboard", "path": "gcp_reporting_dashboard", "path_with_namespace": "gurena/gcp_reporting_dashboard", "created_at": "2026-09-22T14:55:06.312Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com: