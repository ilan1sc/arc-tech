", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/d69611628ac271b97adc2ab3fe800abe8eaca163366143adf09c684cb75f92b9?s=80&d=identicon", "web_url": "https://gitlab.com/Myarcer"}}, {"id": 82781993, "description": "**Autoflightbook** is a free and open-source Android app for automatically logging paragliding and hang gliding flights. It runs a background GPS service that detects take-off and landing events based on configurable speed and proximity thresholds, then records the full GPS track and stores all flights in a local database.\r\n\r\nKey features include an interactive flight logbook with speed charts and OpenStreetMap-based track maps, manual flight entry, flying site management with GPS coordinate import from paraglidingearth.com, and a GPS diagnostics screen. All thresholds (start/stop speed, minimum duration, site match radius) are user-configurable.\r\n\r\nBuilt with Kotlin, Room, OSMDroid, and standard Android APIs \u2014 no Google Maps, no ads, no tracking, and fully offline-capable.", "name": "AutoFlightbook", "name_with_namespace": "Andreas R\u00f6dig / AutoFlightbook", "path": "autoflightbook", "path_with_namespace": "andreas.roedig/autoflightbook", "created_at": "2026-06-02T06:14:10.340Z", "tag_list": ["GPS datalogger", "android", "app", "kotlin", "no-ads", "paragliding"], "topics": ["GPS datalogger", "android", "app", "kotlin", "no-ads", "paragliding"], "ssh_url_to_repo": "git@gitlab.com:andreas.roedig/autoflightbook.git", "http_url_to_repo": "https://gitlab.com/andreas.roedig/autoflightbook.git", "web_url": "https://gitlab.com/andreas.roedig/autoflightbook", "avatar_url": "https://gitlab.com/uploads/-/system/project/avatar/82781993/ic_launcher.png?v=1785629059", "star_count": 0, "last_activity_at": "2026-08-02T00:04:19.083Z", "visibility": "public", "namespace": {"id": 4228760, "name": "Andreas R\u00f6dig", "path": "andreas.roedig", "kind": "user", "full_path": "andreas.roedig", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/3263546/avatar.png?v=1782477417", "web_url": "https://gitlab.com/andreas.roedig"}}, {"id": 81204458, "description": "TerraRoam is an open-source, AI-powered travel intelligence platform built for safe and intelligent exploration across roads, trails, and remote destinations. It combines vehicle-aware navigation, camping and activity discovery, verified reviews, offline-first maps, and a real-time AI co-pilot into one unified system. Designed under the AGPL-3.0+ license, TerraRoam is modular, self-hostable, and built to continuously evolve through community and AI-assisted development.  https://roxanneardary.com/terraroam/", "name": "TerraRoam", "name_with_namespace": "Roxanne Ardary / TerraRoam", "path": "terraroam", "path_with_namespace": "Roxanne_Ardary/terraroam", "created_at": "2026-04-10T20:27:58.486Z", "default_branch": "main", "tag_list": ["AI", "SBL", "SDD", "agplv3", "ai-assistant", "automotive", "legal", "map", "mapping-tools", "navigation", "open source", "open-source", "roxanneardary", "self-hosted", "spec-driven-development", "specification", "specification-branding-license"], "topics": ["AI", "SBL", "SDD", "agplv3", "ai-assistant", "automotive", "legal", "map", "mapping-tools", "navigation", "open source", "open-source", "roxanneardary", "self-hosted", "spec-driven-development", "specification", "specification-branding-license"], "ssh_url_to_repo": "git@gitlab.com:Roxanne_Ardary/terraroam.git", "http_url_to_repo": "https://gitlab.com/Roxanne_Ardary/terraroam.git", "web_url": "https://gitlab.com/Roxanne_Ardary/terraroam", "readme_url": "https://gitlab.com/Roxanne_Ardary/terraroam/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-08-11T09:42:24.709Z", "visibility": "public", "namespace": {"id": 127620387, "name": "Roxanne Ardary", "path": "Roxanne_Ardary", "kind": "user", "full_path": "Roxanne_Ardary", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/cfb773bd0e89e6ce1e5b9a1e71804159d1ac3618d6d8c71e57fb042adc4aea9f?s=80&d=identicon", "web_url": "https://gitlab.com/Roxanne_Ardary"}}, {"id": 80922359, "description": "MamaCare+ is an Android mobile application built with Kotlin Multiplatform that supports pregnant women throughout every stage of their pregnancy journey by combining weekly pregnancy tracking, an AI-powered companion chat, symptom triage, and automated antenatal care scheduling into a single accessible platform. \r\n\r\nThe app calculates gestational age from the user's Last Menstrual Period using Naegele's Rule and delivers personalized weekly updates including baby size comparisons, expected physical changes, and tailored nutrition advice, while a real conversational AI companion powered by Google Gemini 2.5 Flash provides bilingual support in English and Kinyarwanda, classifies any mentioned symptoms as low, medium, or high risk, and triggers emergency call and hospital navigation actions when needed. \r\n\r\nA dedicated symptom checker maps selected symptoms to a three-level risk meter, a WHO-aligned antenatal care schedule is automatically generated from the user's LMP with visit completion tracking and note-saving per appointment, and all user data is stored locally in SQLite ensuring the app works fully offline \u2014 with the core mission of reducing maternal health risks by ensuring no appointment is missed, no warning sign is ignored, and no mother feels alone in her journey.", "name": "Final_project_CE", "name_with_namespace": "KEWACO / Final_project_CE", "path": "mama-care-by-group-ce", "path_with_namespace": "kcbig/mama-care-by-group-ce", "created_at": "2026-04-01T08:25:59.233Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:kcbig/mama-care-by-group-ce.git", "http_url_to_repo": "https://gitlab.com/kcbig/mama-care-by-group-ce.git", "web_url": "https://gitlab.com/kcbig/mama-care-by-group-ce", "readme_url": "https://gitlab.com/kcbig/mama-care-by-group-ce/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-05-13T17:58:02.542Z", "visibility": "public", "namespace": {"id": 54560012, "name": "KEWACO", "path": "kcbig", "kind": "user", "full_path": "kcbig", "parent_id": null, "avatar_url": "https://secure.gravatar.com/avatar/f2a10647acee2d4ebfe2c3e2acd276fa349c6545c739bb6856e45ce1233c0376?s=80&d=identicon", "web_url": "https://gitlab.com/kcbig"}}]}