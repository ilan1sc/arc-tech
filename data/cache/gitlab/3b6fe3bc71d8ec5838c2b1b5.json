{"path": "/projects", "params": {"search": "time sync agent", "per_page": 8, "order_by": "similarity", "sort": "desc", "simple": "true", "visibility": "public"}, "data": [{"id": 88161382, "description": "Daily planner and focus timer PWA that works offline and keeps data on your device. Optional PocketBase sync and an optional local agent that proposes tasks from work already in flight.", "name": "focusflow", "name_with_namespace": "Abdel Wahab Mahmoud / focusflow", "path": "focusflow", "path_with_namespace": "abdelwahab313/focusflow", "created_at": "2026-10-27T14:40:30.564Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:abdelwahab313/focusflow.git", "http_url_to_repo": "https://gitlab.com/abdelwahab313/focusflow.git", "web_url": "https://gitlab.com/abdelwahab313/focusflow", "readme_url": null, "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-10-27T14:40:30.438Z", "visibility": "public", "namespace": {"id": 2353382, "name": "Abdel Wahab Mahmoud", "path": "abdelwahab313", "kind": "user", "full_path": "abdelwahab313", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/1903630/avatar.png?v=1794196115", "web_url": "https://gitlab.com/abdelwahab313"}}, {"id": 82983942, "description": "BrandFuzzySearch is a multi-source search tool that tolerates spelling variants to look up registered trademarks, patents, domain names and companies (legal names, acronyms) across official registries, with geographic priority on the EU and Switzerland.\r\nIt is built as a Rust cargo workspace: a shared core (bfs-core) provides an async Source trait, text normalization (including cross-script transliteration) and a hybrid fuzzy re-ranking engine, while dedicated crates wrap real data sources \u2014 EUIPO, EPO, INPI, INSEE, Swissreg, Zefix, ARES, PRH, CVR/DataFordeler and RDAP. An optional multi-agent LLM pipeline (bfs-llm, llama.cpp) enriches results with analysis grounded in cached open data. It ships as a CLI (bfs), an Axum HTTP API (bfs-api) and an Astro front end.\r\nExternal access is read-only by design (no writes to upstream APIs, enforced by a build-time guardrail), with encryption at rest, GDPR purge, an SBOM and supply-chain checks in CI.\r\n\u26a0\ufe0f  The tool produces a preliminary study only. It does not replace the explanations, research or advice of a professional or of a lawyer specialising in trademark or company registration.\r\nLicensed under MPL-2.0.", "name": "BrandFuzzysearch-LLM", "name_with_namespace": "YP-SEC / BrandFuzzysearch-LLM", "path": "brandfuzzysearch-llm", "path_with_namespace": "ypsec/brandfuzzysearch-llm", "created_at": "2026-06-07T17:46:08.103Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:ypsec/brandfuzzysearch-llm.git", "http_url_to_repo": "https://gitlab.com/ypsec/brandfuzzysearch-llm.git", "web_url": "https://gitlab.com/ypsec/brandfuzzysearch-llm", "readme_url": "https://gitlab.com/ypsec/brandfuzzysearch-llm/-/blob/main/README.md", "forks_count": 0, "avatar_url": null, "star_count": 0, "last_activity_at": "2026-11-01T20:02:06.032Z", "visibility": "public", "namespace": {"id": 117857936, "name": "YP-SEC", "path": "ypsec", "kind": "user", "full_path": "ypsec", "parent_id": null, "avatar_url": "/uploads/-/system/user/avatar/31168312/avatar.png?v=1793861223", "web_url": "https://gitlab.com/ypsec"}}, {"id": 81157572, "description": "An in-process domain firewall for AI agents. It downloads public blocklists, builds a fast lookup index, and exposes a single synchronous check. Zero runtime dependencies; works with any HTTP client or framework.", "name": "agent-dns-firewall", "name_with_namespace": "John Turner / agent-dns-firewall", "path": "agent-dns-firewall", "path_with_namespace": "johnturner/agent-dns-firewall", "created_at": "2026-04-09T12:17:41.151Z", "default_branch": "main", "tag_list": [], "topics": [], "ssh_url_to_repo": "git@gitlab.com:johnturner/agent-dns-firewall.gi